{
  "name": "mbox",
  "version": "1.2.1",
  "description": "Localhost command-line replacement for sMoneyBox.com",
  "repository": "git@github.com:roman-kaspar/mbox.git",
  "author": "Roman Kaspar <roman.kaspar@seznam.cz>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "tsc --target es2022 --module commonjs --esModuleInterop --outDir dist src/mbox.ts",
    "build-dev": "tsc --watch --target es2022 --module commonjs --esModuleInterop --outDir dist src/mbox.ts",
    "check-deps": "yarn depcruise src"
  },
  "renovate": {
    "extends": [
      "config:semverAllMonthly"
    ],
    "bumpVersion": "patch",
    "automerge": true,
    "major": {
      "automerge": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "dependency-cruiser": "^18.0.0",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@fast-csv/format": "^5.0.5",
    "@fast-csv/parse": "^5.0.5",
    "better-sqlite3": "^13.0.0",
    "commander": "^15.0.0",
    "printf": "^0.6.1"
  }
}
